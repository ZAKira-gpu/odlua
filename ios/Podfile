platform :ios, '14.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Xcode 26 workaround: Skip privacy bundle checks
  
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # Skip aggregate targets
    next unless target.respond_to?(:product_type)
    
    target.build_configurations.each do |config|
      config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
      config.build_settings['SWIFT_VERSION'] = '5.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      
      # Fix for App Store validation - ensure proper framework embedding
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      
      # Skip resource validation for all bundle targets (Xcode 26 fix)
      if target.product_type == 'com.apple.product-type.bundle'
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        config.build_settings['CODE_SIGN_IDENTITY'] = ''
        config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'NO'
        # Critical: Skip validation that causes "Resource not found" errors
        config.build_settings['VALIDATE_WORKSPACE'] = 'NO'
      else
        config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'YES'
      end
      
      if target.name == 'FirebaseAuth'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
          '$(inherited)',
          'FIRAuth_VERSION=10.0.0',
        ]
      end
    end
  end
  
  # Fix for Firebase frameworks containing nested Frameworks folder (App Store rejection fix)
  # Remove nested frameworks that cause "disallowed file 'Frameworks'" error
  firebase_frameworks = ['FirebaseAuth', 'FirebaseFirestore', 'FirebaseRemoteConfig', 'FirebaseStorage', 'FirebaseMessaging', 'FirebaseCore']
  firebase_frameworks.each do |framework_name|
    framework_path = File.join(installer.sandbox.root, framework_name, 'Frameworks')
    if File.exist?(framework_path) && File.directory?(framework_path)
      FileUtils.rm_rf(framework_path)
      puts "Removed nested Frameworks from #{framework_name}"
    end
  end
  
  # Fix GoogleMapsResources.bundle symlink issue (ITMS-90332)
  # Copy the actual bundle instead of using symlinks
  google_maps_resources_src = File.join(installer.sandbox.root, 'GoogleMaps', 'Maps', 'Resources', 'GoogleMapsResources', 'GoogleMaps.bundle')
  google_maps_build_dir = File.join(installer.sandbox.root, '..', 'build', 'ios', 'Release-iphoneos', 'GoogleMaps')
  
  # Also add a build phase script to handle the symlink issue during build
  installer.pods_project.targets.each do |target|
    if target.name == 'GoogleMaps-GoogleMapsResources'
      target.build_configurations.each do |config|
        # Ensure resources are copied as files not symlinks
        config.build_settings['COPY_PHASE_STRIP'] = 'NO'
        config.build_settings['STRIP_INSTALLED_PRODUCT'] = 'NO'
      end
    end
  end
  
  # Modify the resources script to handle missing privacy bundles gracefully
  resources_script = File.join(installer.sandbox.root, 'Target Support Files', 'Pods-Runner', 'Pods-Runner-resources.sh')
  if File.exist?(resources_script)
    content = File.read(resources_script)
    # Replace the install_resource function to skip missing privacy bundles and fix symlinks
    new_function = <<-'SCRIPT'
install_resource()
{
  if [[ "$1" == *"_Privacy.bundle"* ]] || [[ "$1" == *"_privacy.bundle"* ]] || [[ "$1" == *"Privacy.bundle"* ]]; then
    # Skip privacy bundles - Xcode 26 workaround
    return 0
  fi
  
  # Fix symlink issues (ITMS-90332) - dereference symlinks when copying
  if [[ -L "$1" ]]; then
    REAL_PATH=$(readlink -f "$1" 2>/dev/null || realpath "$1" 2>/dev/null || echo "$1")
    if [[ -e "$REAL_PATH" ]]; then
      set -- "$REAL_PATH"
    else
      echo "warning: Skipping invalid symlink: $1"
      return 0
    fi
  fi
  
  if [[ "$1" == *".storyboard" ]]; then
    echo "ibtool --reference-external-strings-file --errors --warnings --notices --minimum-deployment-target ${!DEPLOYMENT_TARGET_SETTING_NAME} --output-format human-readable-text --compile ${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/`basename \"$1\" .storyboard`.storyboardc $1 --sdk ${SDKROOT} ${TARGET_DEVICE_ARGS}" || true
    ibtool --reference-external-strings-file --errors --warnings --notices --minimum-deployment-target ${!DEPLOYMENT_TARGET_SETTING_NAME} --output-format human-readable-text --compile "${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/`basename \"$1\" .storyboard`.storyboardc" "$1" --sdk "${SDKROOT}" ${TARGET_DEVICE_ARGS}
  elif [[ "$1" == *".xib" ]]; then
    echo "ibtool --reference-external-strings-file --errors --warnings --notices --minimum-deployment-target ${!DEPLOYMENT_TARGET_SETTING_NAME} --output-format human-readable-text --compile ${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/`basename \"$1\" .xib`.nib $1 --sdk ${SDKROOT} ${TARGET_DEVICE_ARGS}" || true
    ibtool --reference-external-strings-file --errors --warnings --notices --minimum-deployment-target ${!DEPLOYMENT_TARGET_SETTING_NAME} --output-format human-readable-text --compile "${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/`basename \"$1\" .xib`.nib" "$1" --sdk "${SDKROOT}" ${TARGET_DEVICE_ARGS}
  elif [[ "$1" == *".framework" ]]; then
    echo "mkdir -p ${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}" || true
    mkdir -p "${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}"
    echo "rsync --delete -av "${RSYNC_PROTECT_TMP_FILES[@]}" $1 ${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}" || true
    rsync --delete -av "${RSYNC_PROTECT_TMP_FILES[@]}" "$1" "${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}"
  elif [[ "$1" == *".xcdatamodel" ]]; then
    echo "xcrun momc \"$1\" \"${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/`basename \"$1\"`.mom\"" || true
    xcrun momc "$1" "${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/`basename \"$1\" .xcdatamodel`.mom"
  elif [[ "$1" == *".xcdatamodeld" ]]; then
    echo "xcrun momc \"$1\" \"${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/`basename \"$1\" .xcdatamodeld`.momd\"" || true
    xcrun momc "$1" "${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/`basename \"$1\" .xcdatamodeld`.momd"
  elif [[ "$1" == *".xcmappingmodel" ]]; then
    echo "xcrun mapc \"$1\" \"${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/`basename \"$1\" .xcmappingmodel`.cdm\"" || true
    xcrun mapc "$1" "${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/`basename \"$1\" .xcmappingmodel`.cdm"
  elif [[ "$1" == *".xcassets" ]]; then
    ABSOLUTE_XCASSET_FILE="$1"
    XCASSET_FILES+=("$ABSOLUTE_XCASSET_FILE")
  else
    echo "$1" || true
    echo "rsync -av "${RSYNC_PROTECT_TMP_FILES[@]}" $1 ${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/" || true
    rsync -av "${RSYNC_PROTECT_TMP_FILES[@]}" "$1" "${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/"
  fi
}
SCRIPT
    content.gsub!(/^install_resource\(\).*?^}/m, new_function.strip)
    File.write(resources_script, content)
  end
  
  installer.pods_project.save
end
